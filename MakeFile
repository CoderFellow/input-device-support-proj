CC = gcc
CFLAGS = -m32 -ffreestanding -O2 -Wall -Wextra -Ikernel
ASM = nasm
ASMFLAGS = -f win32

C_SOURCES = $(wildcard kernel/*.c)
ASM_SOURCES = $(wildcard boot/*.asm kernel/*.asm)

OBJ = $(C_SOURCES:.c=.o) $(ASM_SOURCES:.asm=.o)

all: os-image.bin

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.asm
	$(ASM) $(ASMFLAGS) $< -o $@

os-image.bin: $(OBJ)
	ld -m i386pe -o os-image.tmp $(OBJ)
	objcopy -O binary os-image.tmp os-image.bin
	rm -f os-image.tmp

clean:
	rm -f kernel/*.o boot/*.o *.bin
