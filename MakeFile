CC = gcc
CFLAGS = -m32 -ffreestanding -O2 -Wall -Wextra -Ikernel
ASM = nasm
ASMFLAGS = -f win32

C_SOURCES = $(wildcard kernel/*.c)
ASM_SOURCES = $(wildcard boot/*.asm kernel/*.asm)

OBJ = $(C_SOURCES:.c=.o) $(ASM_SOURCES:.asm=.o)

all: os-image.bin

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.asm
	$(ASM) $(ASMFLAGS) $< -o $@

os-image.bin: $(OBJ)
	ld -m i386pe --image-base 0x00000000 -o os-image.tmp boot/boot.o kernel/graphics.o kernel/idt.o kernel/kernel.o kernel/keyboard.o kernel/mouse.o kernel/interrupt.o
	objcopy -O binary -j .text -j .rodata os-image.tmp os-image.bin
	rm -f os-image.tmp

clean:
	rm -f kernel/*.o boot/*.o *.bin
